<?xml version="1.0" encoding="utf-8"?><!--
   Android Auto Backup rules (Android 6 to 11). Android 12+ uses data_extraction_rules.xml.
   SEC-03: the PIN hash is never part of Android's backup; temporary import files are not backed up.
   Everything else (places, categories, events, settings, private images) keeps the existing behaviour.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="shareadd_security.xml" />
    <exclude domain="file" path="shareadd_import_staging/" />
    <exclude domain="file" path="shareadd_import_journal.json" />
    <exclude domain="file" path="shareadd_import_journal.json.tmp" />
</full-backup-content>
