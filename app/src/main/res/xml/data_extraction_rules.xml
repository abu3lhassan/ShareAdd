<?xml version="1.0" encoding="utf-8"?><!--
   Android 12+ backup / transfer rules.
   SEC-03: the PIN hash is excluded from both cloud backup and device-to-device transfer;
   temporary import files are excluded too. Other app data keeps the existing behaviour.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="shareadd_security.xml" />
        <exclude domain="file" path="shareadd_import_staging/" />
        <exclude domain="file" path="shareadd_import_journal.json" />
        <exclude domain="file" path="shareadd_import_journal.json.tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="shareadd_security.xml" />
        <exclude domain="file" path="shareadd_import_staging/" />
        <exclude domain="file" path="shareadd_import_journal.json" />
        <exclude domain="file" path="shareadd_import_journal.json.tmp" />
    </device-transfer>
</data-extraction-rules>
